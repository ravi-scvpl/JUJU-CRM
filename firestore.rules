rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) 
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data 
        : {};
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email == "sangeet@socialcloudventures.com" && request.auth.token.email_verified == true) ||
        getUserData().get('role', 'none') == 'admin'
      );
    }

    function isTeamMember() {
      return isAuthenticated() && (
        getUserData().get('role', 'none') in ['admin', 'sales', 'creative']
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.ownerId;
    }

    function isNotificationOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.userId;
    }

    function isValidLead(data) {
      let stages = ["New", "Contacted", "Qualified", "Meeting done", "Proposal shared", "Proposal Sent", "Interested", "Delayed", "Won", "Closed Won", "Lost"];
      
      let emailValid = !("email" in data) || data.email == null || data.email is string;
      let phoneValid = !("phone" in data) || data.phone == null || data.phone is string || data.phone is number;
      let nameValid = data.get('leadName', '') is string;
      let stageValid = data.get('stage', 'New') in stages;
      
      // Allow legacy sources, temperatures freely to unblock updates
      let sourceValid = true;
      let tempValid = true;
      
      let dealValueValid = true; // loosen validation to allow updates
      let lostReasonValid = true;

      return nameValid && emailValid && phoneValid && stageValid && sourceValid && tempValid && dealValueValid && lostReasonValid;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /leads/{leadId} {
      allow read: if isAdmin() || isTeamMember() || isDocOwner();
      
      allow create: if isTeamMember() && 
                    request.resource.data.ownerId == request.auth.uid &&
                    isValidLead(request.resource.data);
      
      allow update: if (isAdmin() || isTeamMember() || isDocOwner()) &&
                    request.resource.data.get('createdAt', '') == resource.data.get('createdAt', '') &&
                    request.resource.data.get('ownerId', '') == resource.data.get('ownerId', '') &&
                    isValidLead(request.resource.data);
      
      allow delete: if isAdmin();

      match /activities/{activityId} {
        allow read: if isAdmin() || isTeamMember();
        allow create: if isTeamMember() && request.resource.data.createdBy == request.auth.uid;
        allow update: if false; // Activities are immutable logs
        allow delete: if isAdmin();
      }
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && (request.resource.data.role == 'sales' || isAdmin());
      allow update: if isAdmin() || (isOwner(userId) && request.resource.data.role == resource.data.role);
    }

    match /notifications/{notificationId} {
      allow read: if isNotificationOwner();
      allow create: if isAuthenticated(); // Allow system or other users to notify
      allow update: if isNotificationOwner() && 
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isNotificationOwner();
    }
  }
}
